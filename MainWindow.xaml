<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCL 下载补丁" Width="940" Height="720" MinWidth="800" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#f7f8fa" FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

  <Window.Resources>
    <SolidColorBrush x:Key="TitleBrush" Color="#262b33"/>
    <SolidColorBrush x:Key="SubBrush" Color="#8791a0"/>
    <SolidColorBrush x:Key="TextBrush" Color="#3d444d"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9aa3af"/>
    <SolidColorBrush x:Key="HintBrush" Color="#a8b0bb"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="#e3e6ea"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#eef0f3"/>
    <SolidColorBrush x:Key="InputBrush" Color="#fbfbfc"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#b3bac4"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3b82f6"/>
    <SolidColorBrush x:Key="LinkBrush" Color="#5b87c7"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#b0413a"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#f0d9d7"/>

    <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,1" EndPoint="1,0">
      <GradientStop Color="#b8894c" Offset="0"/>
      <GradientStop Color="#d0a869" Offset="0.55"/>
      <GradientStop Color="#e3c68f" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border CornerRadius="8" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextOptions.TextFormattingMode="Display"
                                TextOptions.TextRenderingMode="ClearType"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- 输入框去掉系统默认边框与焦点框 -->
    <Style x:Key="CleanTextBox" TargetType="TextBox">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          VerticalAlignment="Center"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="32,22,32,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 头部 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
      <Canvas Width="52" Height="52">
        <Path Data="M 6,16 L 26,16 L 40,26 L 26,36 L 6,36 Z"
              Stroke="{StaticResource GoldBrush}" StrokeThickness="2.6"
              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Canvas>
      <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="PCL 下载补丁" FontSize="23" Foreground="{StaticResource TitleBrush}"/>
        <TextBlock Text="恢复新版 PCL 被关闭的下载功能" FontSize="13"
                   Foreground="{StaticResource SubBrush}" Margin="0,4,0,0"/>
        <TextBlock Text="by 沐序 · 启动器原作者 龙腾猫跃 LTCat" FontSize="11.5"
                   Foreground="#a8b0bb" Margin="0,3,0,0"/>
        <TextBlock x:Name="LnkRepo" FontSize="11.5" Margin="0,2,0,0" Cursor="Hand"
                   Foreground="#a8b0bb" TextDecorations="Underline"
                   Text="github.com/AldricXZ/PCL-Download-Patch"/>
      </StackPanel>
    </StackPanel>

    <!-- 主卡片 -->
    <Border Grid.Row="1" CornerRadius="14" Background="White"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect Color="#232d3c" BlurRadius="18" ShadowDepth="3"
                          Direction="270" Opacity="0.10"/>
      </Border.Effect>
      <Grid>
        <!-- 卷草纹（右下角，坐标直接来自 HTML 预览稿） -->
        <Viewbox Width="126" Height="126" Stretch="Uniform"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,16,12" IsHitTestVisible="False">
          <Canvas Width="200" Height="200">
            <Canvas Opacity="0.10">
              <Path Data="M26 168 C 8 150, 10 118, 34 106 C 56 95, 78 105, 80 124 C 82 141, 66 152, 55 145 C 46 139, 47 127, 56 125"
                    Stroke="{StaticResource GoldBrush}" StrokeThickness="2.1"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              <Path Data="M34 106 C 62 86, 92 72, 122 58 C 144 48, 162 36, 172 22"
                    Stroke="{StaticResource GoldBrush}" StrokeThickness="2.1"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              <Path Data="M172 22 C 182 8, 197 12, 198 25 C 199 36, 188 42, 181 36"
                    Stroke="{StaticResource GoldBrush}" StrokeThickness="2.1"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              <Path Data="M122 58 C 116 80, 118 102, 132 114 C 142 123, 156 120, 157 109 C 158 100, 148 96, 143 102"
                    Stroke="{StaticResource GoldBrush}" StrokeThickness="2.1"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              <Path Data="M92 72 C 88 54, 92 38, 102 28"
                    Stroke="{StaticResource GoldBrush}" StrokeThickness="1.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M62 86 C 54 70, 52 54, 58 42"
                    Stroke="{StaticResource GoldBrush}" StrokeThickness="1.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
            <Canvas Opacity="0.075">
              <Path Data="M102 28 C 106 14, 118 6, 128 8 C 124 22, 114 30, 102 28 Z" Fill="{StaticResource GoldBrush}"/>
              <Path Data="M58 42 C 52 28, 56 14, 66 10 C 70 24, 66 38, 58 42 Z" Fill="{StaticResource GoldBrush}"/>
              <Path Data="M144 48 C 152 34, 166 28, 176 32 C 168 46, 156 52, 144 48 Z" Fill="{StaticResource GoldBrush}"/>
              <Path Data="M80 124 C 68 118, 62 106, 66 96 C 78 102, 84 114, 80 124 Z" Fill="{StaticResource GoldBrush}"/>
              <Path Data="M132 114 C 142 122, 146 134, 141 143 C 130 136, 126 124, 132 114 Z" Fill="{StaticResource GoldBrush}"/>
            </Canvas>
            <!-- 三瓣小花：花 A (66,10) 缩放 0.62；花 B (181,36) 缩放 0.5 -->
            <Canvas Opacity="0.085">
              <Ellipse Width="11.16" Height="16.12" Fill="{StaticResource GoldBrush}" Canvas.Left="60.42" Canvas.Top="-6.12"/>
              <Ellipse Width="11.16" Height="16.12" Fill="{StaticResource GoldBrush}" Canvas.Left="67.24" Canvas.Top="6.28"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform Angle="120"/></Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="11.16" Height="16.12" Fill="{StaticResource GoldBrush}" Canvas.Left="53.60" Canvas.Top="6.28"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform Angle="-120"/></Ellipse.RenderTransform>
              </Ellipse>
            </Canvas>
            <Canvas Opacity="0.085">
              <Ellipse Width="9" Height="13" Fill="{StaticResource GoldBrush}" Canvas.Left="176.5" Canvas.Top="23"/>
              <Ellipse Width="9" Height="13" Fill="{StaticResource GoldBrush}" Canvas.Left="182" Canvas.Top="33"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform Angle="120"/></Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="9" Height="13" Fill="{StaticResource GoldBrush}" Canvas.Left="171" Canvas.Top="33"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform Angle="-120"/></Ellipse.RenderTransform>
              </Ellipse>
            </Canvas>
          </Canvas>
        </Viewbox>

        <!-- 卡片内容 -->
        <StackPanel Margin="24,20,24,18">
          <TextBlock Text="启动器" FontSize="15" Foreground="#30363f" Margin="0,0,0,10"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Height="40" CornerRadius="8" Background="{StaticResource InputBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                    Padding="12,0,12,0" Margin="0,0,14,0">
              <TextBox x:Name="TxtPath" Style="{StaticResource CleanTextBox}"
                       Foreground="{StaticResource PlaceholderBrush}" FontSize="13"
                       VerticalContentAlignment="Center" AllowDrop="True"
                       Text="把 Plain Craft Launcher 2.exe 拖到这里，或点右侧浏览"/>
            </Border>
            <TextBlock Grid.Column="1" Text="浏览…" Foreground="{StaticResource LinkBrush}"
                       FontSize="13.5" VerticalAlignment="Center" Cursor="Hand"
                       x:Name="LnkBrowse"/>
          </Grid>

          <TextBlock Text="更新后如何自动恢复补丁" Foreground="#5b6470" FontSize="13"
                     Margin="0,14,0,8"/>

          <StackPanel x:Name="RadioHost"/>

          <Grid x:Name="ChkBackup" Margin="0,7,0,0" Cursor="Hand" Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="14" Height="14" VerticalAlignment="Center">
              <Border x:Name="ChkBox" CornerRadius="4" BorderThickness="1.4"
                      BorderBrush="#cfd4da" Background="Transparent"/>
              <Path x:Name="ChkMark" Data="M 2.5,7 L 5.5,10.5 L 11.5,3"
                    Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed"/>
            </Grid>
            <TextBlock Grid.Column="1" Text="打补丁前复制一份备份到同目录"
                       Foreground="#6b7280" FontSize="13" Margin="9,0,0,0"
                       VerticalAlignment="Center"/>
          </Grid>

          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                     Foreground="{StaticResource HintBrush}">
            <Run Text="补丁会自动在包内保留原始 exe（约 6MB），用于「卸载补丁」完整还原 · "/>
            <Run x:Name="LnkClean" Text="清理原始备份" Foreground="#6f9ad4" Cursor="Hand"
                 TextDecorations="Underline"/>
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 按钮行 -->
    <Grid Grid.Row="2" Margin="0,22,0,0">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BtnPatch" Content="开始打补丁" Width="132" Style="{StaticResource PrimaryButton}"/>
        <Button x:Name="BtnLaunch" Content="启动PCL" Width="116" Margin="12,0,0,0" Style="{StaticResource GhostButton}"/>
        <Button x:Name="BtnUninstall" Content="卸载补丁" Width="116" Margin="12,0,0,0" Style="{StaticResource DangerButton}"/>
      </StackPanel>
      <TextBlock x:Name="LblStatus" Text="就绪" Foreground="{StaticResource MutedBrush}"
                 FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>

    <!-- 日志 -->
    <Border Grid.Row="3" CornerRadius="10" Background="White"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
            Margin="0,14,0,0" Padding="18,14,18,14" MinHeight="190">
      <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="LogPanel"/>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
